# Server Configuration
PROJECT_NAME=PoshanScan Backend
API_V1_STR=/api/v1
PORT=8000
DEBUG=True

# Database (Default: SQLite for local zero-config, or PostgreSQL / Supabase connection string)
DATABASE_URL=sqlite:///./poshanscan.db
# For Supabase / PostgreSQL:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Security & JWT
JWT_SECRET=super-secret-key-change-in-production-poshanscan-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/CV Microservice (Yash's Service on Hugging Face Spaces or localhost:8001)
CV_SERVICE_URL=http://localhost:8001
MOCK_CV=True

# File Storage
UPLOAD_DIR=./uploads
